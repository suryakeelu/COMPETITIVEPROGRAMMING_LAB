def cycle_len(n):
    count = 1
    while n != 1:
        if n % 2 == 0:
            n = n // 2
        else:
            n = 3 * n + 1
        count += 1
    return count
i ,j = map(int,input().split())
start , end = i,j
if start > end:
    start,end = end,start
max_cycle = 0
for num in range(start,end+1):
    max_cycle = max(max_cycle,cycle_len(num))
print(i,j,max_cycle)
