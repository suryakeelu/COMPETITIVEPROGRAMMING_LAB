# Enter your code here. Read input from STDIN. Print output to STDOUT
x, y = map(float, input().split())

if y == 0:
    print("Division by zero")
else:
    sign = -1 if (x < 0) != (y < 0) else 1

    x = abs(x)
    y = abs(y)

    low = 0
    high = max(1, x)

    eps = 1e-7

    while high - low > eps:
        mid = (low + high) / 2

        if y * mid < x:
            low = mid
        else:
            high = mid

    result = sign * (low + high) / 2

    if abs(result - round(result)) < 1e-6:
        print(round(result))
    else:
        print(f"{result:.6f}")
