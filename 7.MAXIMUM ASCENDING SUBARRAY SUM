# Enter your code here. Read input from STDIN. Print output to STDOUT
n = int(input())
arr = list(map(int,input().split()))
def max_asc(arr):
    current_sum = arr[0]
    max_sum = arr[0]
    for i in range(1,n):
        if arr[i] > arr[i-1]:
            current_sum += arr[i]
        else:
            current_sum = arr[i]
        if current_sum > max_sum:
            max_sum = current_sum
    return max_sum
print(max_asc(arr))
