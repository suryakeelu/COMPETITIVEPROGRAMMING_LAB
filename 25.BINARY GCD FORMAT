a,b = map(int,input().split())
def binary_gcd(a, b):
    if a == 0:
        return abs(b)
    if b == 0:
        return abs(a)

    a, b = abs(a), abs(b)
    shift = 0
    while ((a | b) & 1) == 0:
        a >>= 1
        b >>= 1
        shift += 1
    while (a & 1) == 0:
        a >>= 1

    while b != 0:
        while (b & 1) == 0:
            b >>= 1
        if a > b:
            a, b = b, a
        b -= a
    return a << shift
print(binary_gcd(a, b))
